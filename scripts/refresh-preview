#!/usr/bin/env bash
# Keep Family Hub PREVIEW a realistic current week without starting over: top up her content, sync the
# pretend calendar events, put the safe notification settings back (a phone may have registered on
# Preview since the last run) and verify. Scheduled daily and at start-up (plan 02-09).
#
# This never stops Preview, never erases anything and never asks a question, so it is safe to run
# while she is using it. --yes is accepted only so every Preview script can be called the same way.
#
#   scripts/refresh-preview [--yes]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

for arg in "$@"; do
  case "$arg" in
    --yes) ;;
    *)
      echo "usage: scripts/refresh-preview [--yes]" >&2
      exit 2
      ;;
  esac
done

fh_load_env
fh_lock preview

# WSL stops when nothing holds it open, which takes Preview with it (Pitfall 5): say so plainly.
if ! fh_seed preview --timeout 300 wait; then
  echo "Preview is not running - refresh skipped (is WSL/Docker up?)" >&2
  exit 1
fi
# D-08: every chosen Google calendar is saved before the refresh writes anything. This is after the
# running check because a calendar kept as an ha-snapshot is read from the running instance.
fh_backup_calendars preview
fh_seed preview refresh
echo "Preview refreshed: $(date +%Y-%m-%d)"
