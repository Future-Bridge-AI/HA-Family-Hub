# Host-specific values for Dev and Preview. Copy this file to dev/host.env (gitignored) and edit.
# Read by: dev/compose*.yaml (via --env-file), scripts/lib.sh, the seed tool (tools/seed, via --env-file)
# and scripts/doctor. Plain KEY=value lines, no quotes. Do not repeat HA_VERSION: it lives in versions.env.
# Every value below is invented; put the real ones in dev/host.env only.

# Container time zone and Home Assistant time_zone.
TZ=Europe/London

# Home Assistant core settings applied by the seed tool.
HA_COUNTRY=GB
HA_CURRENCY=GBP
# metric or us_customary
HA_UNIT_SYSTEM=metric
HA_LATITUDE=51.5000
HA_LONGITUDE=-0.1200
HA_ELEVATION=10
HA_LANGUAGE=en

# The laptop's DHCP-reserved Wi-Fi address; the Preview certificate and the phone URL use it.
PREVIEW_HOST_IP=192.168.50.10

# Address Preview's port 8124 is published on. 0.0.0.0 reaches the home network; Dev is always 127.0.0.1.
PREVIEW_BIND=0.0.0.0

# WSL distribution name, used by doctor and the Windows scheduled tasks.
WSL_DISTRO=Ubuntu
